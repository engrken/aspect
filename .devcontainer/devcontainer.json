{
  "name": "aspect",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ms-python.python"
      ],
      "settings": {
        "github.copilot.chat.codeGeneration.useInstructionFiles": true
      }
    }
  },
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "Private development preview",
      "onAutoForward": "notify"
    }
  },
  "containerEnv": {
    "TZ": "Asia/Manila"
  }
}
